        "faq": {
                "title": "FAQ",
                "subtitle": "About the TeenAIgers Hackathon",
                "contact": {
                        "title": "Any other questions? Contact us:",
                        "email": "Email: carriemcrena@gmail.com",
                        "wechat": "WeChat: carrii_yy29"
