# 复制成 .env.local 再填。.env.local 不会被提交。

# Supabase 项目地址，形如 https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase 的 anon / public key —— 这个密钥设计上就是给浏览器用的，
# 真正的安全靠数据库的 RLS 策略（见 supabase/migrations/0001_init.sql）。
VITE_SUPABASE_ANON_KEY=

# ⚠️ 绝对不要把 service_role key 填在这里，也不要以 VITE_ 前缀暴露任何服务端密钥。
#    带 VITE_ 前缀的变量会被打包进浏览器可见的 JS 里。
